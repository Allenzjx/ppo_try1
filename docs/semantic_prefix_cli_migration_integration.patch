+def checkpoint_reset_distribution(metadata):
+    value = metadata.get("reset_distribution")
+    if value is None:
+        if PREFIX_FILE in metadata["runtime_contract"].get("files", {}):
+            raise ValueError("prefix-capable checkpoint must declare its reset distribution")
+        return reset_distribution()
+    target = value.get("target_phase") if value.get("kind") == "fixed_teacher_suffix" else None
+    if value != reset_distribution(target):
+        raise ValueError("checkpoint reset distribution is malformed")
+    return value
