+        raise ValueError("video instrumentation requires an explicit review reason")
+    if set(delta) - INSTRUMENTATION_FILES - VIDEO_FILES:
+        raise ValueError("video publication cannot change task/nominal/reward/action/backend")
+    if any(path in old["files"] for path in VIDEO_FILES) or not VIDEO_FILES <= set(new["files"]):
+        raise ValueError("video factor permits only the complete reviewed additive three-file publication")
+    hashes = {path: file_sha(project_root / path) for path in sorted(VIDEO_FILES)}
+    if any(hashes[path] != new["files"][path] for path in VIDEO_FILES):
+        raise ValueError("video source bytes differ from reviewed target contract")
+    return {"schema": "wlr50_clean.semantic_video_instrumentation_migration.v1",
+            "review_reason": str(review["reason"]).strip(), "added_file_sha256": hashes,
+            "training_or_task_behavior_changed": False,
+            "evaluation_optimizer_updates": 0, "video_success_or_improvement_certified": False}
