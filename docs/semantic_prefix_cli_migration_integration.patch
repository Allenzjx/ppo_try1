+    return {**topology(1), "schema": "wlr50_clean.semantic_execution_topology.v2",
+            "reset_sampling": PREFIX_SAMPLING, "prefix_target": target,
+            "phase_suffix_curriculum_implemented": True,
+            "phase_suffix_scope": "one_fixed_P09_or_P10_request_not_full_mixture"}
