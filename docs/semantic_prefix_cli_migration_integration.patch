+def _reset_distribution_factor(metadata, new, review, delta, project_root):
+    if not isinstance(review, Mapping) or set(review) != {"reason", "target_phase"} or not str(review["reason"]).strip():
+        raise ValueError("reset distribution requires explicit reviewed reason and target phase")
+    if source_num_envs(metadata) != 1:
+        raise ValueError("finish an explicit 8-to-1 boundary before changing reset distribution")
+    old = metadata["runtime_contract"]
+    source, target = checkpoint_reset_distribution(metadata), reset_distribution(review["target_phase"])
+    if source == target:
+        raise ValueError("reset distribution factor must name an actual distribution boundary")
+    allowed = INSTRUMENTATION_FILES | {PREFIX_FILE, SUPERVISOR}
+    if set(delta) - allowed or PREFIX_FILE not in new["files"]:
+        raise ValueError("reset distribution touched protected behavior/configuration")
+    di = None
+    if SUPERVISOR in delta:
+        if PREFIX_FILE in old["files"]:
+            raise ValueError("reset factor cannot revise existing prefix adoption behavior")
+        di = _prefix_di_only(_version_text(project_root, old, SUPERVISOR),
+                             _version_text(project_root, new, SUPERVISOR, prefer_worktree=True))
+    elif PREFIX_FILE not in old["files"]:
+        raise ValueError("first prefix publication must bind the reviewed public DI extension")
+    if PREFIX_FILE in old["files"] and old["files"][PREFIX_FILE] != new["files"][PREFIX_FILE]:
+        raise ValueError("distribution selection does not authorize changing prefix implementation")
+    if file_sha(project_root / PREFIX_FILE) != new["files"][PREFIX_FILE]:
+        raise ValueError("prefix source bytes differ from reviewed target contract")
+    return {"schema": "wlr50_clean.semantic_reset_distribution_migration.v1",
+            "review_reason": str(review["reason"]).strip(), "source": source, "target": target,
+            "public_DI_delta": di, "prefix_source_sha256": new["files"][PREFIX_FILE],
+            "old_rollout_storage_reused": False, "saved_actor_critic_Adam_normalizer_RNG_preserved": True,
+            "physical_reset": "fresh_P01_then_bounded_teacher_prefix_before_any_policy_sample",
+            "task_deadline_s": 200, "prefix_clock_reset_at_credit_boundary": False}
+
+
+def _video_instrumentation_factor(old, new, review, delta, project_root):
