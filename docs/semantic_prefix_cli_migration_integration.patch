+def _prefix_di_only(before, after):
+    """Remove precisely the additive DI seams; existing behavior must be identical."""
+    import ast
+    # The evaluator and task supervisor are not an extension point for this factor.
+    marker = "class NominalMotionProvider:"
+    if before.split(marker, 1)[0] != after.split(marker, 1)[0]:
+        raise ValueError("prefix adoption cannot change evaluator/task supervisor bytes")
+    old, new = ast.parse(before), ast.parse(after)
+    old_classes = {node.name: node for node in old.body if isinstance(node, ast.ClassDef)}
+    new_classes = {node.name: node for node in new.body if isinstance(node, ast.ClassDef)}
+    additions = {"NominalMotionProvider": "from_handoff",
+                 "SemanticControllerAdapter": "from_live_prefix"}
+    for class_name, method_name in additions.items():
+        source_class, target_class = old_classes[class_name], new_classes[class_name]
+        if any(isinstance(node, ast.FunctionDef) and node.name == method_name for node in source_class.body):
+            raise ValueError("prefix DI addition is only allowed at its first reviewed publication")
+        methods = [node for node in target_class.body if isinstance(node, ast.FunctionDef) and node.name == method_name]
+        if len(methods) != 1:
+            raise ValueError("prefix DI public method addition is missing/ambiguous")
+        target_class.body.remove(methods[0])
+    constructor = next(node for node in new_classes["SemanticControllerAdapter"].body
+                       if isinstance(node, ast.FunctionDef) and node.name == "__init__")
+    # Exactly the two default-None injection options; no altered ordinary constructor.
+    for name in ("supervisor", "nominal_provider"):
+        positions = [i for i, arg in enumerate(constructor.args.kwonlyargs) if arg.arg == name]
+        if len(positions) != 1:
+            raise ValueError("prefix DI constructor option is missing/ambiguous")
+        index = positions[0]
+        if not isinstance(constructor.args.kw_defaults[index], ast.Constant) or constructor.args.kw_defaults[index].value is not None:
+            raise ValueError("prefix DI must leave default construction unchanged")
+        constructor.args.kwonlyargs.pop(index); constructor.args.kw_defaults.pop(index)
+    expected = {
+        "supervisor": "TaskStageSupervisor(task_spec_path)",
+        "nominal_provider": "NominalMotionProvider(contract, spec=self.supervisor.spec)",
+    }
+    for name, expression in expected.items():
+        matches = [node for node in constructor.body if isinstance(node, ast.Assign) and
+                   len(node.targets) == 1 and ast.unparse(node.targets[0]) == "self." + name]
+        expected_value = ast.parse(f"{expression} if {name} is None else {name}", mode="eval").body
+        if len(matches) != 1 or ast.dump(matches[0].value) != ast.dump(expected_value):
+            raise ValueError("prefix DI altered ordinary controller construction")
+        matches[0].value = ast.parse(expression, mode="eval").body
+    if ast.dump(old) != ast.dump(new):
+        raise ValueError("prefix publication changed existing nominal/controller behavior outside DI")
+    return {"evaluator_and_task_supervisor_bytes_unchanged": True,
+            "ordinary_nominal_and_controller_behavior_AST_unchanged": True,
+            "before_source_sha256_LF": hashlib.sha256(before.encode()).hexdigest(),
+            "after_source_sha256_LF": hashlib.sha256(after.encode()).hexdigest(),
+            "added_public_methods": list(additions.values())}
+
