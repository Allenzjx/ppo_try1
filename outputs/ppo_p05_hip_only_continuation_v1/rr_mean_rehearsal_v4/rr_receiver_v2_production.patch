+    elif bad == "source_v2": source[m.MODE_KEY] = m.MODE_V2
+    elif bad == "source_unknown": source[m.MODE_KEY] = "unknown"
+    elif bad == "target_unknown": target[m.MODE_KEY] = "unknown"
