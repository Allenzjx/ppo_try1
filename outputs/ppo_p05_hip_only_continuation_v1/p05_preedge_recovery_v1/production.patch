+ROOT = Path(state_spec.__file__).resolve().parents[3]
+CFG = ROOT / "configs/ppo_p05_hip_only_continuation_v1/stage_task_spec.yaml"
+KEY = "p05_preedge_approach_recovery"
+ROLL = (.3,) * 4
