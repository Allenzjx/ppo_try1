+def _rolling():
+    x = _latent(5)
+    x[0, 154:156] = 1  # Actual placement history is not current support.
+    x[0, 132] = x[0, 134] = 1
+    x[0, 124] = x[0, 126] = .1
+    x[0, 22] = x[0, 25] = .1
+    x[0, 100] = x[0, 103] = -.1
