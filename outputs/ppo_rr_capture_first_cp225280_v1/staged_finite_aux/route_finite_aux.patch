+def validate_finite_aux_rebind_runtime(old, new):
+    """Metadata-only support publication; task/control/actor/physics stay exact."""
+    def digest(value, length=64):
+        return (isinstance(value, str) and len(value) == length
+                and all(c in '0123456789abcdef' for c in value))
+    if (old.get('source_git_commit') != FINITE_AUX_REBIND_SOURCE_HEAD
+            or not digest(new.get('source_git_commit'), 40)
+            or new['source_git_commit'] == FINITE_AUX_REBIND_SOURCE_HEAD):
+        raise ValueError('finite AUX publication requires exact1e source and a new HEAD')
+    allowed = {'source_git_commit', 'runtime_content_sha256', 'files'}
+    if set(old) != set(new) or any(old[k] != new[k] for k in old if k not in allowed):
+        raise ValueError('finite AUX publication changed protected config/task/actor/physics runtime')
+    for runtime in (old, new):
+        files = runtime['files']
+        if not files or any(not digest(v) for v in files.values()):
+            raise ValueError('finite AUX runtime file digest invalid')
+        calculated = hashlib.sha256(json.dumps(files, sort_keys=True,
+            separators=(',', ':')).encode()).hexdigest()
+        if runtime['runtime_content_sha256'] != calculated:
+            raise ValueError('finite AUX runtime inventory digest mismatch')
+        cfg = runtime['local_contract']
+        if (cfg.get('observation_dimension') != 448
+                or cfg.get('schema') != 'wlr50_clean.rr_capture_local_contract.v2'
+                or cfg.get('version') != 'frozen_cp225280_raw_head_plus_local448_lineage_v2'
+                or cfg.get('source_tracking_owner_revision') != SAME448_REBIND_REVISION
+                or cfg.get('capture_source_dispatch') !=
+                    'rr_local_defer_p09_late_and_new_p12_until_terminal_v2'):
+            raise ValueError('finite AUX publication requires exact448 corrected tracking contract')
+        for name, item in runtime['selected_configuration'].items():
+            if (item.get('path') != 'configs/' + NAME + '/' + name
+                    or files.get(item['path']) != item.get('sha256')):
+                raise ValueError('finite AUX selected configuration is unbound')
+    old_files, new_files = old['files'], new['files']
+    if (set(old_files) - set(new_files)
+            or set(new_files) - set(old_files) != {FINITE_AUX_ADDED_FILE}
+            or {p for p in old_files if old_files[p] != new_files[p]} != {FINITE_AUX_ROUTE_FILE}):
+        raise ValueError('finite AUX publication allows only route edit plus one new AUX helper')
+    return {p: {'before': old_files.get(p), 'after': new_files[p]}
+            for p in (FINITE_AUX_ROUTE_FILE, FINITE_AUX_ADDED_FILE)}
+
