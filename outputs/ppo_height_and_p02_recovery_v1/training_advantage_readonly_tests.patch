+def audit(snapshot, requests, **overrides):
+    kwargs = dict(first_global_decision=168193, ppo_update=1280,
+                  gamma=.9985, gae_lambda=.99, normalize_advantage_per_mini_batch=False)
+    kwargs.update(overrides)
+    return _rollout_advantage_audit(snapshot, requests, **kwargs)
