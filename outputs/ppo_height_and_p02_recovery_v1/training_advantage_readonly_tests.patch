+def test_raw_and_normalized_are_distinct_grouped_by_actual_request_without_mutation_or_rng_use():
+    snapshot, requests = example()
+    before = {key: value.clone() for key, value in snapshot.items()}
+    request_before = deepcopy(requests)
+    rng = torch.get_rng_state().clone()
+    row = audit(snapshot, requests)
+    assert row["sample_count"] == 6
+    assert {p: r["sample_count"] for p, r in row["by_request_phase"].items()} == {"P01": 2, "P02": 3, "P03": 1}
+    assert row["overall"]["raw_gae_returns_minus_old_values"]["minimum"] == -45.
+    assert row["overall"]["raw_gae_returns_minus_old_values"]["positive_count"] == 3
+    assert row["overall"]["stored_advantages"]["mean"] == pytest.approx(0., abs=1e-7)
+    assert row["by_request_phase"]["P02"]["old_values"]["mean"] == pytest.approx(14/3)
+    assert row["overall"]["returns"]["minimum"] == -40.
+    assert row["stored_advantage_semantics"] == "official_whole_rollout_standardized_GAE"
+    assert all(torch.equal(before[key], value) for key, value in snapshot.items())
+    assert requests == request_before and torch.equal(rng, torch.get_rng_state())
+    json.dumps(row, allow_nan=False)
+
