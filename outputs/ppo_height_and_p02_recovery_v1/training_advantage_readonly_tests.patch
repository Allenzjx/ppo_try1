+                      physics_tick=8*(t+1), physics_ticks=8, sim_time_s=8*(t+1)/120.,
+                      termination_reason=None, terminal_bootstrap_allowed=True)
+                 for phase in row] for t, row in enumerate(phases)]
+    requests[1][0]["end_phase_id"] = "P03"  # Ordinary transition is not done.
+    requests[2][0].update(physics_tick=19, physics_ticks=3, sim_time_s=19/120.,
+                          termination_reason="HARD_JOINT_LIMIT", terminal_bootstrap_allowed=False)
+    return snapshot, requests
+
