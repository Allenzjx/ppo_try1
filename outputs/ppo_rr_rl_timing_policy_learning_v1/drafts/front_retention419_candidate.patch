+"""UNAPPLIED 419 finite ancestor-query retention candidate; no import-time fit/save.
+
+Targets are offline conditional raw means queried from a separately bound
+ancestor on sealed STUDENT observations. They are not actually executed actions,
+success demonstrations, nominal targets, current-policy draws or PPO data.
+
+Only a temporary 256 x 2 first-layer leaf is optimized.  These two columns
+multiply exact P01/P02 indicators, not physical feature columns.  A change can
+alter ALL twelve means AND sigmas in P01/P02.  It cannot change the same-input
+Gaussian in P03--P13, where both indicators are zero.  Different future visited
+states can still produce different actions; this is not physical invariance.
+"""
+from __future__ import annotations
+
+from dataclasses import asdict, dataclass
+import math
+from pathlib import Path
+import sys
+
+ROOT = Path(__file__).resolve().parents[3]
+if str(ROOT / "src") not in sys.path:
+    sys.path.insert(0, str(ROOT / "src"))
+
+import torch
+from tensordict import TensorDict
+from wlr50_clean.ppo import semantic_training as training
+from wlr50_clean.ppo.semantic_history_actor import HISTORY_RHO, history_conditioned_head
+from wlr50_clean.ppo.semantic_rear_policy_timing_actor import (
+    SemanticRearPolicyTimingHistoryMLPModel, rear_policy_timing_effective_log_std)
+from wlr50_clean.ppo.semantic_p05_capture_actor import p05_capture_request_history
+
+SCHEMA = "wlr50_clean.finite_front_retention419_phase_columns_aux.v1"
+CHANNELS = ("FL_hip", "FL_knee", "FR_hip", "FR_knee", "RL_hip", "RL_knee",
+            "RR_hip", "RR_knee", "FL_wheel", "FR_wheel", "RL_wheel", "RR_wheel")
+UNITS = ("deg",) * 8 + ("rad/s",) * 4
+
