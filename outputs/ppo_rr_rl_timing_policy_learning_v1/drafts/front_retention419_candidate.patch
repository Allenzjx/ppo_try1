+def inspect(actor, train_obs, targets_raw, validation_obs, validation_targets_raw, invariance_obs):
+    """Read-only same-device inspection; CLI uses CPU before authorization."""
+    target, vtarget = _dataset(actor, train_obs, targets_raw, validation_obs,
+                               validation_targets_raw, invariance_obs)
+    original_hash = training.parameter_hash(actor)
+    rng = torch.get_rng_state().clone()
+    with torch.no_grad():
+        td, vd, inv = (distribution(actor, obs) for obs in (train_obs, validation_obs, invariance_obs))
+        require(torch.equal(td["mean"], actor(train_obs, stochastic_output=False)),
+                "inspection mean disagrees with official deterministic actor")
+    leaf = torch.nn.Parameter(first_layer(actor).weight[:, :2].detach().clone())
+    candidate = distribution(actor, train_obs, leaf)
+    loss = .5 * (candidate["mean"] - target).square().mean()
+    gradient, = torch.autograd.grad(loss, (leaf,))
+    require(bool(torch.isfinite(gradient).all()), "nonfinite inspection gradient")
+    response = {"semantics": "read-only JVP along negative frozen initial gradient; unit LR tangent, not an SGD update or finite-step prediction",
+                "train": _first_gradient_response(actor, train_obs, leaf, gradient),
+                "validation": _first_gradient_response(actor, validation_obs, leaf, gradient),
+                "raw_half_MSE_per_unit_lr": -float(gradient.square().sum()),
+                "optimizer_steps_performed": 0, "finite_step_or_closed_loop_success_prediction": False}
+    require(training.parameter_hash(actor) == original_hash and torch.equal(torch.get_rng_state(), rng),
+            "inspection changed actor or CPU RNG")
+    return {"schema": SCHEMA + ".inspection", "automatic_aux_enabled": False,
+            "channel_order": CHANNELS, "requested_residual_units": UNITS,
+            "train": _summary(td, target), "validation": _summary(vd, vtarget),
+            "invariance_holdout": _summary(inv),
+            "actual_invariance_phase_ids": sorted(set(int(v) + 1 for v in invariance_obs["policy"][:, :13].argmax(-1))),
+            "selected_gradient_l2": float(gradient.norm()),
+            "selected_gradient_by_phase_column_l2": _values(gradient.norm(dim=0)),
+            "selected_gradient_full256x2": _values(gradient),
+            "frozen_first_gradient_response": response,
+            "gradient_semantics": "true conditional mean derivative; HISTORY rho=.9, chain=.1; no rescaling",
+            "optimized_parameter_scope": "actor.mlp.0.weight[:,0:2] only (512 scalars)",
+            "P01_P02_mean_and_sigma_may_both_change": True,
+            "request_semantics": "cap*tanh(raw mean), before mapper/filter/projection/nominal; not final drive",
+            "same_input_P03_P13_math": "exact one-hot phase has x[0]=x[1]=0, hence DeltaW*x=0",
+            "PPO_decisions_added": 0, "PPO_updates_added": 0, "PPO_optimizer_steps_added": 0,
+            "teacher_deployed": False, "offline_ancestor_queries_used": True,
+            "targets_were_executed_actions": False, "physical_success_claimed": False}
