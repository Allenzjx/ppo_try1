+def fit(runner, train_obs, targets_raw, validation_obs, validation_targets_raw, invariance_obs,
+        *, budget: Budget, authorized=False):
+    """Independent, finite, constant-LR SGD; only last accepted leaf is copied.
+
+    A rejected proposal restores the WHOLE 512-scalar temporary leaf, then stops.
+    Every trust comparison is against the initial model, not merely last step.
+    Raw-target holdout loss is reported, not a fixed accept-rate/success gate.
+    This method does not save, publish, change ledgers, sample or run physics.
+    """
+    require(authorized is True, "AUX requires explicit authorization after CPU inspection")
+    budget.validate()
+    require(runner.alg.storage.step == 0 and runner.alg.transition.actions is None,
+            "AUX requires verified complete-update boundary and fresh empty rollout")
+    actor, critic = runner.alg.actor, runner.alg.critic
+    target, vtarget = _dataset(actor, train_obs, targets_raw, validation_obs,
+                               validation_targets_raw, invariance_obs)
+    layer = first_layer(actor)
+    before = {k: v.detach().clone() for k, v in actor.state_dict().items()}
+    gradients = {k: None if p.grad is None else p.grad.detach().clone() for k, p in actor.named_parameters()}
+    hashes = {"actor": training.parameter_hash(actor), "critic": training.parameter_hash(critic),
+              "optimizer": training.state_hash(runner.alg.optimizer.state_dict()),
+              "normalizers": training.state_hash(training._normalizers(runner))}
+    rng = training.capture_training_rng_state(seed=runner.cfg["seed"])
+    lr = (runner.alg.learning_rate, training.optimizer_learning_rate(runner))
+    initial = inspect(actor, train_obs, target, validation_obs, vtarget, invariance_obs)
+    probes = _math_probe(invariance_obs)
+    with torch.no_grad():
+        base, held, inv, mathbase = (_detached(distribution(actor, obs)) for obs in
+                                    (train_obs, validation_obs, invariance_obs, probes))
+    leaf = torch.nn.Parameter(layer.weight[:, :2].detach().clone())
+    optimizer = torch.optim.SGD([leaf], lr=budget.learning_rate, momentum=0., weight_decay=0.)
+    records, stop = [], "finite_budget_exhausted"
+    try:
+        with torch.no_grad():
+            require(_exact_invariance(base, distribution(actor, train_obs, leaf)),
+                    "functional leaf does not match original full actor")
+        for index in range(budget.max_attempts):
+            proposed = distribution(actor, train_obs, leaf)
+            loss = .5 * (proposed["mean"] - target).square().mean()
+            require(bool(torch.isfinite(loss)), "nonfinite auxiliary loss")
+            if float(loss.detach()) < 1e-14:
+                stop = "raw_conditional_means_already_match_selected_targets"
+                break
+            gradient, = torch.autograd.grad(loss, (leaf,))
+            require(bool(torch.isfinite(gradient).all()), "nonfinite auxiliary gradient")
+            if not bool(gradient.any()):
+                stop = "zero_selected_gradient_no_optimizer_step"
+                break
+            previous_leaf = leaf.detach().clone()
+            leaf.grad = gradient
+            optimizer.step()  # independent temporary SGD, NEVER runner PPO Adam
+            optimizer.zero_grad(set_to_none=True)
+            rejection = []
+            with torch.no_grad():
+                if torch.equal(leaf, previous_leaf):
+                    rejection.append("numerically_unchanged_full512_proposal")
+                try:
+                    cand, valid, ip, mp = (distribution(actor, obs, leaf) for obs in
+                                           (train_obs, validation_obs, invariance_obs, probes))
+                    change, vchange = gaussian_change(base, cand), gaussian_change(held, valid)
+                    next_loss = .5 * (cand["mean"] - target).square().mean()
+                    if not all(bool(torch.isfinite(t).all()) for d in (cand, valid, change, vchange) for t in d.values()):
+                        rejection.append("nonfinite_candidate")
+                    if float(next_loss) > float(loss.detach()):
+                        rejection.append("training_raw_target_loss_increased")
+                    for name, delta, limit in (("train", change, budget.maximum_train_request_shift_full12),
+                                                ("validation", vchange, budget.maximum_validation_request_shift_full12)):
+                        if bool((delta["requested_residual_delta"].abs().amax(0)
+                                 > delta["requested_residual_delta"].new_tensor(limit)).any()):
+                            rejection.append(name + "_REQUEST_bound")
+                        if max(float(delta["kl_original_to_candidate"].max()), float(delta["kl_candidate_to_original"].max())) > budget.maximum_per_state_full_gaussian_kl:
+                            rejection.append(name + "_full_Gaussian_KL_bound")
+                        if float(delta["log_sigma_delta"].abs().max()) > budget.maximum_abs_log_sigma_change:
+                            rejection.append(name + "_log_sigma_bound")
+                    real_equal, math_equal = _exact_invariance(inv, ip), _exact_invariance(mathbase, mp)
+                    if not real_equal or not math_equal:
+                        rejection.append("protected_same_input_Gaussian_changed")
+                    row = {"attempt": index + 1, "learning_rate": budget.learning_rate,
+                           "loss_before": float(loss.detach()), "loss_after_candidate": float(next_loss),
+                           "validation_raw_mse_after_candidate": float((valid["mean"] - vtarget).square().mean()),
+                           "selected_gradient_l2": float(gradient.norm()),
+                           "train_candidate": _summary(cand), "validation_candidate": _summary(valid),
+                           "train_change_from_original": _change_report(base, cand),
+                           "validation_change_from_original": _change_report(held, valid),
+                           "real_holdout_entire_Gaussian_bitwise_equal": real_equal,
+                           "synthetic_P03_P13_math_probes_bitwise_equal": math_equal}
+                except (ValueError, RuntimeError, OverflowError) as error:
+                    rejection.append("unrepresentable_candidate")
+                    row = {"attempt": index + 1, "learning_rate": budget.learning_rate,
+                           "loss_before": float(loss.detach()), "candidate_error": str(error)}
+                row.update(accepted=not rejection, rejection_reasons=rejection)
+                if rejection:
+                    leaf.copy_(previous_leaf)
+                    require(torch.equal(leaf, previous_leaf), "rejected full512 leaf rollback failed")
+                    row["rejected_full512_leaf_restored"] = True
+                    stop = "first_candidate_rejected_then_stop_no_LR_search"
+                records.append(row)
+            if rejection:
+                break
+        # No original actor parameter was modified during any proposal.
+        require(training.parameter_hash(actor) == hashes["actor"], "proposal modified live actor")
+        with torch.no_grad():
+            layer.weight[:, :2].copy_(leaf)
+        for key, value in actor.state_dict().items():
+            require(torch.equal(value[:, 2:], before[key][:, 2:]) if key == "mlp.0.weight"
+                    else torch.equal(value, before[key]), "non-whitelisted actor state changed")
+        with torch.no_grad():
+            require(_exact_invariance(inv, distribution(actor, invariance_obs))
+                    and _exact_invariance(mathbase, distribution(actor, probes)),
+                    "final protected same-input Gaussian changed")
+        require(training.parameter_hash(critic) == hashes["critic"]
+                and training.state_hash(runner.alg.optimizer.state_dict()) == hashes["optimizer"]
+                and training.state_hash(training._normalizers(runner)) == hashes["normalizers"],
+                "critic/PPO Adam/normalizers changed")
+        require((runner.alg.learning_rate, training.optimizer_learning_rate(runner)) == lr
+                and training.capture_training_rng_state(seed=runner.cfg["seed"]) == rng,
+                "PPO learning rate or complete training RNG changed")
+        for key, p in actor.named_parameters():
+            require(p.grad is None if gradients[key] is None else p.grad is not None
+                    and torch.equal(p.grad, gradients[key]), "live actor gradients changed")
+        final = inspect(actor, train_obs, target, validation_obs, vtarget, invariance_obs)
+        final_hash = training.parameter_hash(actor)
+        require(not any(r["accepted"] for r in records) or final_hash != hashes["actor"],
+                "accepted AUX steps require an actually changed actor")
+        return {"schema": SCHEMA, "budget": asdict(budget), "steps": records,
+                "accepted_auxiliary_updates": sum(r["accepted"] for r in records),
+                "attempted_auxiliary_optimizer_steps": len(records), "stop_reason": stop,
+                "before": initial, "after": final, "optimized_scalar_count": 512,
+                "optimized_parameters": ["actor.mlp.0.weight[:,0:2]"],
+                "auxiliary_optimizer": "independent one-leaf constant-LR SGD; momentum=0; weight_decay=0",
+                "objective": "half mean squared error to offline ancestor conditional raw means on student states; not executed labels or PPO",
+                "validation_target_loss_is_reported_not_an_accept_rate_gate": True,
+                "P01_P02_mean_and_sigma_may_both_change": True,
+                "kernel_or_sigma_rule_changed": False, "MDP_or_control_changed": False,
+                "actor_parameter_sha256_before": hashes["actor"],
+                "actor_parameter_sha256_after": final_hash,
+                "PPO_Adam_preserved_sha256": hashes["optimizer"], "PPO_LR_preserved": lr[0],
+                "training_rng_preserved": True, "fresh_PPO_rollout_required": True,
+                "PPO_decisions_added": 0, "PPO_updates_added": 0, "PPO_optimizer_steps_added": 0,
+                "teacher_deployed": False, "offline_ancestor_queries_used": True,
