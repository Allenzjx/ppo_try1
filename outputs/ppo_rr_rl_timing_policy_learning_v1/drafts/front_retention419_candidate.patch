+def _first_gradient_response(actor, obs, leaf, gradient):
+    def outputs(candidate):
+        d = distribution(actor, obs, candidate)
+        return torch.cat((d["mean"], d["log_sigma"], d["request"]), dim=-1)
+    _, tangent = torch.autograd.functional.jvp(outputs, leaf, -gradient, create_graph=False, strict=True)
+    return {"raw_mean_per_unit_lr_full12": _values(tangent[:, :12]),
+            "log_sigma_per_unit_lr_full12": _values(tangent[:, 12:24]),
+            "requested_residual_per_unit_lr_full12": _values(tangent[:, 24:36]),
+            "maximum_abs_requested_residual_per_unit_lr_per_channel": _values(tangent[:, 24:36].abs().amax(0))}
+
