+def gaussian_change(before, after):
+    """Full diagonal Gaussian, both KL directions including sigma changes."""
+    dlog = after["log_sigma"] - before["log_sigma"]
+    dmu = after["mean"] - before["mean"]
+    # Inspect the actual float32 Gaussian parameters in float64 and use expm1:
+    # naive float32 variance-ratio subtraction can hide a small positive KL.
+    old_sigma, new_sigma = before["sigma"].double(), after["sigma"].double()
+    log_ratio = (new_sigma / old_sigma).log()
+    delta = after["mean"].double() - before["mean"].double()
+    forward = (log_ratio + .5 * (torch.expm1(-2 * log_ratio)
+                                + (delta / new_sigma).square())).sum(-1).clamp_min(0)
+    reverse = (-log_ratio + .5 * (torch.expm1(2 * log_ratio)
+                                 + (delta / old_sigma).square())).sum(-1).clamp_min(0)
+    return {"kl_original_to_candidate": forward, "kl_candidate_to_original": reverse,
+            "log_sigma_delta": dlog, "raw_mean_delta": dmu,
+            "requested_residual_delta": after["request"] - before["request"]}
+
+
+def _exact_invariance(before, after):
+    return all(torch.equal(before[key], after[key]) for key in ("mean", "log_sigma", "sigma", "request"))
+
+
+def _change_report(before, after):
+    return {k: _values(v) for k, v in gaussian_change(before, after).items()}
+
