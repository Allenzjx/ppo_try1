+def _math_probe(invariance_obs):
+    # Synthetic algebraic coverage only; not invented physical P13 evidence.
+    x = invariance_obs["policy"][:1].repeat(11, 1).clone()
+    x[:, :13] = 0
+    x[torch.arange(11, device=x.device), torch.arange(2, 13, device=x.device)] = 1
+    return tensors(x, device=x.device)
+
