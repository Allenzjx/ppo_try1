+def _dataset(actor, train_obs, targets_raw, validation_obs, validation_targets_raw, invariance_obs):
+    first_layer(actor)
+    for obs in (train_obs, validation_obs, invariance_obs):
+        validate_observation(obs["policy"])
+    tx, vx, ix = (o["policy"] for o in (train_obs, validation_obs, invariance_obs))
+    require(bool((tx[:, :2].sum(-1) == 1).all())
+            and bool((vx[:, :2].sum(-1) == 1).all()), "train/validation are P01/P02 only")
+    require(bool((ix[:, :2] == 0).all()), "invariance holdout requires real P03+ states")
+    # Different original source-row IDs are verified by the data loader. Also
+    # reject accidental exact-observation leakage between selected partitions.
+    require(tx.device == vx.device == ix.device == first_layer(actor).weight.device,
+            "all datasets and actor must use one unchanged source device")
+    train_rows = {row.numpy().tobytes() for row in tx.detach().cpu()}
+    require(not any(row.numpy().tobytes() in train_rows for row in vx.detach().cpu()),
+            "train and validation states must be disjoint")
+    return _targets(targets_raw, len(tx), tx.device), _targets(validation_targets_raw, len(vx), vx.device)
+
+
+def _summary(d, target=None):
+    result = {k + "_full12": _values(v) for k, v in d.items()}
+    if target is not None:
+        error = d["mean"] - target
+        request_error = d["request"] - d["caps"] * target.tanh()
+        result.update(queried_ancestor_conditional_raw_mean_full12=_values(target),
+                      conditional_raw_mse=float(error.square().mean()),
+                      conditional_raw_half_mse=float(.5 * error.square().mean()),
+                      requested_residual_error_full12=_values(request_error),
+                      requested_residual_absolute_error_mean_per_channel=_values(request_error.abs().mean(0)),
+                      target_negative_log_likelihood_mean=float(-torch.distributions.Normal(
+                          d["mean"], d["sigma"]).log_prob(target).sum(-1).mean()))
+    return result
+
