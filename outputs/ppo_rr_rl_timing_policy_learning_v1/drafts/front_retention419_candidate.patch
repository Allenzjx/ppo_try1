+def require(condition, message):
+    if not condition:
+        raise ValueError(message)
+
+
+@dataclass(frozen=True)
+class Budget:
+    # Deliberately no automatic real-data budget or learning-rate search.
+    max_attempts: int
+    learning_rate: float
+    maximum_train_request_shift_full12: tuple[float, ...]
+    maximum_validation_request_shift_full12: tuple[float, ...]
+    maximum_per_state_full_gaussian_kl: float
+    maximum_abs_log_sigma_change: float
+
+    def validate(self):
+        require(type(self.max_attempts) is int and 1 <= self.max_attempts <= 32,
+                "finite AUX budget requires 1..32 attempts")
+        for name in ("learning_rate", "maximum_per_state_full_gaussian_kl",
+                     "maximum_abs_log_sigma_change"):
+            value = getattr(self, name)
+            require(type(value) in (float, int) and math.isfinite(value) and value > 0,
+                    "budget must explicitly provide positive finite " + name)
+        for name in ("maximum_train_request_shift_full12",
+                     "maximum_validation_request_shift_full12"):
+            values = getattr(self, name)
+            require(isinstance(values, (tuple, list)) and len(values) == 12
+                    and all(type(v) in (float, int) and math.isfinite(v) and v > 0 for v in values),
+                    "budget requires twelve positive finite REQUEST bounds: " + name)
+
+
+def tensors(observations, *, device="cpu"):
+    require(torch.device(device).type in ("cpu", "cuda"), "candidate supports source CPU/CUDA device")
+    x = torch.as_tensor(observations, dtype=torch.float32, device=device)
+    validate_observation(x)
+    return TensorDict({"policy": x, "critic": x.clone()}, batch_size=[len(x)], device=x.device)
+
+
+def validate_observation(x):
+    require(isinstance(x, torch.Tensor) and x.device.type in ("cpu", "cuda")
+            and x.dtype == torch.float32 and x.ndim == 2 and x.shape[1] == 419
+            and 1 <= len(x) <= 2048, "states require bounded source-device float32 N x 419")
+    require(bool(torch.isfinite(x).all()) and bool((x.abs() <= 20).all()),
+            "states must preserve finite schema-clipped observations")
+    bits = x[:, :13]
+    require(bool(((bits == 0) | (bits == 1)).all()) and bool((bits.sum(-1) == 1).all()),
+            "phase features must be exact binary one-hot P01--P13")
+
+
+def first_layer(actor):
+    require(type(actor) is SemanticRearPolicyTimingHistoryMLPModel,
+            "only current SemanticRearPolicyTimingHistoryMLPModel is supported")
+    require(actor.obs_dim == 419 and not actor.is_recurrent
+            and actor.exploration_std_temperature == .25 and HISTORY_RHO == .9,
+            "current 419/full12 quarter-sigma HISTORY kernel required")
+    require(type(actor.obs_normalizer) is torch.nn.Identity, "actor must retain Identity normalization")
+    require(len(actor.mlp) == 6 and type(actor.mlp[0]) is torch.nn.Linear
+            and type(actor.mlp[1]) is torch.nn.ELU and type(actor.mlp[2]) is torch.nn.Linear
+            and type(actor.mlp[3]) is torch.nn.ELU and type(actor.mlp[4]) is torch.nn.Linear
+            and type(actor.mlp[5]) is torch.nn.Unflatten,
+            "unexpected canonical 256/256 mean+log-sigma MLP")
+    layer = actor.mlp[0]
+    require(tuple(layer.weight.shape) == (256, 419) and tuple(layer.bias.shape) == (256,)
+            and tuple(actor.mlp[2].weight.shape) == (256, 256)
+            and tuple(actor.mlp[4].weight.shape) == (24, 256), "unexpected actor shapes")
+    require(layer.weight.device.type in ("cpu", "cuda")
+            and all(p.device == layer.weight.device and p.dtype == torch.float32 for p in actor.parameters()),
+            "candidate requires source-device float32 actor")
+    require(dict(actor.named_parameters())["mlp.0.weight"] is layer.weight,
+            "first-layer binding mismatch")
+    return layer
+
+
+def distribution(actor, obs, leaf=None):
+    """Exact pure official mu/log-sigma kernel; no sample/cache/RNG update.
+
+    Unlike a mean-only surrogate, this evaluates the learned sigma head and the
+    official rear-policy multiplier on the exact full419 observation.
+    """
+    layer = first_layer(actor)
+    x = obs["policy"]
+    validate_observation(x)
+    require(x.device == layer.weight.device, "observation and actor must retain the same source device")
+    latent = actor.get_latent(obs)
+    require(torch.equal(latent, x), "Identity observation normalization required")
+    center, evidence = p05_capture_request_history(latent[:, :389])
+    if leaf is None:
+        raw_head = actor.mlp(latent)
+    else:
+        require(tuple(leaf.shape) == (256, 2) and leaf.device == layer.weight.device
+                and leaf.dtype == layer.weight.dtype, "temporary leaf must contain all 512 selected scalars")
+        weight = torch.cat((leaf, layer.weight[:, 2:].detach()), dim=1)
+        raw_head = torch.func.functional_call(actor.mlp, {"0.weight": weight}, (latent,))
+    head = history_conditioned_head(raw_head, center, HISTORY_RHO)
+    log_sigma, _ = rear_policy_timing_effective_log_std(head[:, 1, :], latent, .25)
+    mu = head[:, 0, :]
+    cap = evidence["current_cap_full12"]
+    return {"mean": mu, "log_sigma": log_sigma, "sigma": log_sigma.exp(),
+            "network_mean": raw_head[:, 0, :], "history": center, "caps": cap,
+            "request": cap * mu.tanh()}
+
+
+def _values(value):
+    return value.detach().cpu().tolist()
+
+
+def _detached(d):
+    return {k: v.detach().clone() for k, v in d.items()}
+
+
+def _targets(values, rows, device):
+    value = torch.as_tensor(values, dtype=torch.float32, device=device)
+    require(value.shape == (rows, 12) and bool(torch.isfinite(value).all()),
+            "targets must be bound offline ancestor conditional raw means, never final or nominal targets")
+    return value
+
