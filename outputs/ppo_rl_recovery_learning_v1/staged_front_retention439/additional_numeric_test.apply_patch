+    deps=kernel._numeric_dependencies()
+    actor=make().alg.actor
+    x=torch.zeros(3,439)
+    for row,phase in enumerate((9,10,11)):
+        x[row,phase]=1.;x[row,20]=.03;x[row,158:158+phase]=1.
+    observations=kernel.tensors(x,deps=deps)
